# ─── Sanity CMS ─────────────────────────────────────────────────────────────
#
# Cómo obtener estos valores:
# 1. Entra en https://sanity.io y crea una cuenta (gratis)
# 2. Crea un nuevo proyecto → anota el Project ID
# 3. En Vercel: Settings → Environment Variables → añade cada variable
#
# El studio estará disponible en: https://tu-dominio.vercel.app/studio
# También puedes usar: https://neuralo.sanity.studio (si configuras el alias)

# ID del proyecto de Sanity (ej: "abc1def2")
NEXT_PUBLIC_SANITY_PROJECT_ID=

# Dataset — usa "production" salvo que necesites staging
NEXT_PUBLIC_SANITY_DATASET=production

# Token de API con permisos de escritura
# Obtenerlo en: sanity.io → tu proyecto → API → Tokens → Add API token
# Permisos necesarios: Editor (para leer y escribir contenido)
SANITY_API_TOKEN=

# ─── Opcional ────────────────────────────────────────────────────────────────

# URL pública del sitio (para SEO y OpenGraph)
NEXT_PUBLIC_SITE_URL=https://neuralo.es
